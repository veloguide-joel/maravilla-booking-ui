{
  "rewrites": [
    {
      "source": "/",
      "destination": "/consumer/booking-test.html"
    },
    {
      "source": "/consumer",
      "destination": "/consumer/booking-test.html"
    },
    {
      "source": "/consumer/",
      "destination": "/consumer/booking-test.html"
    },
    {
      "source": "/property/:id",
      "destination": "/consumer/booking-test.html"
    },
    {
      "source": "/property/:id/",
      "destination": "/consumer/booking-test.html"
    },
    {
      "source": "/guides/bucerias",
      "destination": "/consumer/pages/bucerias.html"
    },
    {
      "source": "/about/why-micasadirect",
      "destination": "/consumer/pages/why-micasadirect.html"
    },
    {
      "source": "/about/team",
      "destination": "/consumer/pages/team.html"
    },
    {
      "source": "/contact",
      "destination": "/consumer/pages/contact.html"
    },
    {
      "source": "/hosts",
      "destination": "/consumer/pages/hosts.html"
    },
    {
      "source": "/manage",
      "destination": "/consumer/pages/manage.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
